<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.customer.pages.PlaceOrderController" prefWidth="600.0" prefHeight="400.0">
    <top>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <ImageView fitWidth="48.0" fitHeight="27.0">
                    <image>
                        <Image url="@/view/assets/kfc_logo.png" />
                    </image>
                </ImageView>
                <Label text="Place Order" style="-fx-font-size: 18; -fx-font-weight: bold;" />
            </children>
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="30" />
                <ColumnConstraints percentWidth="70" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
            </padding>
            <children>
                <Label text="Product" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="productField" promptText="e.g., Zinger Burger" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="Price ($)" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <TextField fx:id="priceField" promptText="e.g., 9.99" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <Label text="Status" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <ComboBox fx:id="statusCombo" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                <Label text="Ship To" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <TextField fx:id="addressField" promptText="Shipping address" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                <Label text="Email" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <TextField fx:id="emailField" promptText="Customer email" GridPane.rowIndex="4" GridPane.columnIndex="1" />
            </children>
        </GridPane>
    </center>
    <bottom>
        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <children>
                <Button text="Cancel" onAction="#onCancel" />
                <Button text="Place Order" onAction="#onSubmit" />
            </children>
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>